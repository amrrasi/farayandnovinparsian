Options -Indexes +FollowSymLinks -MultiViews

ServerSignature Off

RewriteEngine On

RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d [OR]
RewriteCond %{REQUEST_FILENAME} -l
RewriteRule ^ - [L]

RewriteRule ^about-us/?$ about-us.php [END]
RewriteRule ^contact-us/?$ contact-us.php [END]
RewriteRule ^login/?$ login.php [END]
RewriteRule ^register/?$ register.php [END]
RewriteRule ^account/?$ account.php [END]
RewriteRule ^cart/?$ cart.php [END]
RewriteRule ^checkout/?$ checkout.php [END]
RewriteRule ^orders/?$ orders.php [END]

RewriteRule ^blogs/?$ blogs.php [END]

RewriteRule ^team/?$ team.php [END]

RewriteRule ^products/?$ products.php [END]

RewriteRule ^products/([^/]+)/?$ products.php?category=$1 [END,QSA]

RewriteRule ^products/([^/]+)/([^/]+)/?$ product.php?category=$1&slug=$2 [END,QSA]

RewriteRule ^blog/([^/]+)/?$ blog.php?slug=$1 [END,QSA]

ErrorDocument 404 /404.php
